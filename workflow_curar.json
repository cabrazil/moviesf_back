      "parameters": {
        "chatId": "={{ $('Detectar Tipo').first().json.chatId }}",
        "text": "=🎉 *Filme Curado e Publicado com Sucesso!*\n\n🎬 *{{ $json.movie.title }}* ({{ $json.movie.year }})\n🔗 Acesse na vitrine:\n{{ $json.movie.url }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "credentials": {
