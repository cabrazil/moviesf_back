{
  "name": "Vibesfilm: /curar Inteligente",
  "nodes": [
    {
      "id": "curar-001",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        300
      ],
      "webhookId": "vibesfilm-curar-command-01",
      "parameters": {
        "updates": [
          "message",
          "callback_query"
        ],
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram Bot Vibesfilm"
        }
      }
    },
    {
      "id": "curar-002",
      "name": "Detectar Tipo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        300
      ],
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nif (data.callback_query) {\n  const cq = data.callback_query;\n  const parts = (cq.data || '').split(':');\n  return [{ json: {\n    eventType: 'callback',\n    action: parts[0] || '',\n    pendingId: parts[1] || '',\n    chatId: cq.message.chat.id,\n    callbackQueryId: cq.id\n  }}];\n}\n\nconst text = data.message?.text || '';\nconst chatId = data.message?.chat?.id;\nreturn [{ json: { eventType: 'command', text, chatId } }];"
      }
    },
    {
      "id": "curar-003",
      "name": "É Callback?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        640,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "check-type",
              "leftValue": "={{ $json.eventType }}",
              "rightValue": "callback",
              "operator": {
                "type": "string",
                "operation": "equals",
                "name": "filter.operator.equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "curar-004",
      "name": "É /curar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        860,
        160
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "check-curar",
              "leftValue": "={{ $json.text }}",
              "rightValue": "/curar",
              "operator": {
                "type": "string",
                "operation": "startsWith",
                "name": "filter.operator.startsWith"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "curar-005",
      "name": "Parsear Filme e Ano",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        160
      ],
      "parameters": {
        "jsCode": "const data = $('Detectar Tipo').first().json;\nconst args = data.text.replace(/^\\/curar\\s*/i, '').trim();\nconst yearMatch = args.match(/\\b(\\d{4})\\s*$/);\nconst year = yearMatch ? parseInt(yearMatch[1], 10) : null;\nconst title = yearMatch ? args.replace(yearMatch[0], '').trim() : args;\nreturn [{ json: { title, year, chatId: data.chatId } }];"
      }
    },
    {
      "id": "curar-006",
      "name": "API Curate Preview",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1300,
        160
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.vibesfilm.com/api/curate/preview",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ title: $('Parsear Filme e Ano').first().json.title, year: $('Parsear Filme e Ano').first().json.year }) }}"
      }
    },
    {
      "id": "curar-007",
      "name": "Montar Mensagem Preview",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1520,
        160
      ],
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst chatId = $('Parsear Filme e Ano').first().json.chatId;\n\nif (!resp.success || resp.error) {\n  return [{ json: { chatId, text: `❌ Erro na curadoria: ${resp.error || 'Não encontrado'}`, pendingId: null, hasError: true } }];\n}\n\nconst opts = resp.topOptions || [];\nconst o1 = opts[0];\nconst o2 = opts[1];\n\nlet text = `🎬 *Curadoria Encontrada:*\\n*${resp.movie.title}* (${resp.movie.year || 'N/A'})\\n\\n`;\n\nif (o1) {\n  text += `🥇 *1ª Opção:* ${o1.sentiment} ➔ ${o1.intention}\\n`;\n  if (o1.intentionDescription) text += `🎯 _\"${o1.intentionDescription}\"_\\n`;\n  text += `📝 \"${o1.journeyText}\"\\n`;\n  text += `⭐ Score: *${o1.score}* (${o1.tier} • Cobertura: ${o1.coverage})\\n\\n`;\n}\n\nif (o2) {\n  text += `🥈 *2ª Opção:* ${o2.sentiment} ➔ ${o2.intention}\\n`;\n  if (o2.intentionDescription) text += `🎯 _\"${o2.intentionDescription}\"_\\n`;\n  text += `📝 \"${o2.journeyText}\"\\n`;\n  text += `⭐ Score: *${o2.score}* (${o2.tier} • Cobertura: ${o2.coverage})\\n\\n`;\n}\n\ntext += `Deseja publicar essas duas jornadas?`;\n\nreturn [{ json: { chatId, text, pendingId: resp.pendingId, hasError: false } }];"
      }
    },
    {
      "id": "curar-008",
      "name": "Enviar Card Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1740,
        160
      ],
      "parameters": {
        "chatId": "={{ $json.chatId }}",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        },
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "✅ Publicar 2 Humores",
                    "additionalFields": {
                      "callback_data": "=confirm:{{ $json.pendingId }}"
                    }
                  },
                  {
                    "text": "❌ Cancelar",
                    "additionalFields": {
                      "callback_data": "=cancel:{{ $json.pendingId }}"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram Bot Vibesfilm"
        }
      }
    },
    {
      "id": "curar-009",
      "name": "Confirmar ou Cancelar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        860,
        440
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "check-action",
              "leftValue": "={{ $json.action }}",
              "rightValue": "confirm",
              "operator": {
                "type": "string",
                "operation": "equals",
                "name": "filter.operator.equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "curar-010",
      "name": "API Confirm Curate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1080,
        380
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.vibesfilm.com/api/curate/confirm-pending/{{ $json.pendingId }}",
        "sendHeaders": true,
